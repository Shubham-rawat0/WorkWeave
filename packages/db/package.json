{
  "name": "@WorkOrchestrator/prisma",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "echo 'Skipping Prisma build - using generated client'",
    "generate": "prisma generate",
    "push": "DOTENV_CONFIG_PATH=../../.env prisma --config ../../prisma.config.ts db push",
    "seed": "tsx src/seed.ts",
    "hard-delete-airtable-email": "tsx src/hard-delete-airtable-email.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7",
    "pg": "^8.23.1",
    "prisma": "7"
  },
  "devDependencies": {
    "@WorkOrchestrator/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1"
  }
}