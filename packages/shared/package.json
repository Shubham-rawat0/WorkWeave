{
  "name": "@WorkOrchestrator/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./nodeRegistry": {
      "types": "./src/nodes/nodeRegistry.ts",
      "default": "./src/nodes/nodeRegistry.ts"
    },
    "./redis": {
      "types": "./src/runtime/redis.ts",
      "default": "./src/runtime/redis.ts"
    },
    "./queue": {
      "types": "./src/runtime/queue.ts",
      "default": "./src/runtime/queue.ts"
    },
    "./runLock": {
      "types": "./src/runtime/runLock.ts",
      "default": "./src/runtime/runLock.ts"
    },
    "./executionSignature": {
      "types": "./src/runtime/executionSignature.ts",
      "default": "./src/runtime/executionSignature.ts"
    },
    "./crypto": {
      "types": "./src/security/crypto.ts",
      "default": "./src/security/crypto.ts"
    },
    "./ssrf": {
      "types": "./src/security/ssrf.ts",
      "default": "./src/security/ssrf.ts"
    },
    "./parser": {
      "types": "./src/parser/parser.ts",
      "default": "./src/parser/parser.ts"
    }
  },
  "dependencies": {
    "bullmq": "^6.3.12",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0"
  }
}
